{
  "name": "similar-ticket-search",
  "version": "1.0.0",
  "description": "Find historical support tickets that are semantically similar to a new ticket, using embeddings and cosine similarity.",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "serve": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.9"
  },
  "keywords": [
    "embeddings",
    "semantic-search",
    "cosine-similarity"
  ],
  "author": "Goutham Bittla",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
